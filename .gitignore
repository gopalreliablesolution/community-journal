# Ignore top-level docs, scratch files, & internal tools
/*.md
!/README.md
/*.html
/*.json
/*.png
.kilocode/

# Dependencies
node_modules/
**/node_modules/

# Environment variables & secrets
.env
**/.env
ADMIN_CREDENTIALS.md

